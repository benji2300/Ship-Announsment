<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ship Announcement System Pro</title>
    <!-- Google Fonts for Maritime look -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <!-- FIREBASE TILFØJET HER -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>

    <style>
        :root {
            --marine-dark: #0A192F;
            --marine-blue: #112240;
            --marine-card: #1D3557;
            --marine-accent: #00A8E8;
            --gold-accent: #E5A93C;
            --text-white: #FFFFFF;
            --text-dim: #A8B2D1;
            --danger-red: #E63946;
            --success-green: #2A9D8F;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
        }

        body {
            background-color: var(--marine-dark);
            color: var(--text-white);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Header / Topbar */
        header {
            background-color: var(--marine-blue);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 3px solid var(--gold-accent);
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--text-white);
        }

        .logo-icon {
            font-size: 2rem;
            color: var(--gold-accent);
        }

        .ship-status {
            font-size: 0.9rem;
            color: var(--marine-accent);
            background: rgba(0, 168, 232, 0.1);
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid var(--marine-accent);
        }

        /* Main Layout */
        .container {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
            padding: 20px;
            flex: 1;
        }

        /* Sidebar - Folders & Saved Announcements */
        .sidebar {
            background-color: var(--marine-blue);
            border-radius: 8px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 8px;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--gold-accent);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-add {
            background: var(--marine-accent);
            color: var(--marine-dark);
            border: none;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-add:hover {
            transform: scale(1.1);
            background: var(--gold-accent);
        }

        .folder-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .folder-item {
            padding: 10px 12px;
            background-color: var(--marine-card);
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.2s;
        }

        .folder-item:hover, .folder-item.active {
            background-color: var(--marine-accent);
            color: var(--marine-dark);
            font-weight: 500;
        }

        .folder-item .delete-folder {
            color: var(--danger-red);
            font-weight: bold;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .folder-item .delete-folder:hover {
            background: rgba(230, 57, 70, 0.2);
        }

        .saved-announcements {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .saved-card {
            background: var(--marine-card);
            padding: 12px;
            border-radius: 6px;
            border-left: 4px solid var(--gold-accent);
            position: relative;
        }

        .saved-card h4 {
            font-size: 0.95rem;
            margin-bottom: 4px;
        }

        .saved-card p {
            font-size: 0.85rem;
            color: var(--text-dim);
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .saved-card-actions {
            display: flex;
            gap: 8px;
        }

        /* Main Content Area */
        .main-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            background-color: var(--marine-blue);
            border-radius: 8px;
            padding: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        textarea {
            width: 100%;
            height: 120px;
            background-color: var(--marine-dark);
            border: 1px solid var(--marine-accent);
            border-radius: 6px;
            color: var(--text-white);
            padding: 12px;
            font-size: 1rem;
            resize: vertical;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        textarea:focus {
            outline: none;
            border-color: var(--gold-accent);
            box-shadow: 0 0 8px rgba(229, 169, 60, 0.3);
        }

        /* Control Grid Layout */
        .controls-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
            background: rgba(10, 25, 47, 0.5);
            padding: 16px;
            border-radius: 6px;
            border: 1px solid rgba(0, 168, 232, 0.2);
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .control-group label {
            font-size: 0.85rem;
            color: var(--gold-accent);
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-select, .form-input, .file-input {
            width: 100%;
            padding: 8px 12px;
            background-color: var(--marine-card);
            border: 1px solid var(--marine-accent);
            border-radius: 6px;
            color: var(--text-white);
            font-size: 0.9rem;
        }

        .audio-status {
            font-size: 0.75rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        /* Language Checkboxes */
        .lang-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }

        .lang-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--marine-card);
            padding: 10px 14px;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            border: 1px solid transparent;
            transition: all 0.2s;
        }

        .lang-checkbox:has(input:checked) {
            border-color: var(--marine-accent);
            background: rgba(0, 168, 232, 0.15);
        }

        .lang-checkbox input {
            accent-color: var(--marine-accent);
            width: 18px;
            height: 18px;
        }

        /* Buttons */
        .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 20px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            font-size: 0.95rem;
        }

        .btn-primary {
            background-color: var(--marine-accent);
            color: var(--marine-dark);
        }

        .btn-primary:hover {
            background-color: #33bbf5;
        }

        .btn-secondary {
            background-color: var(--gold-accent);
            color: var(--marine-dark);
        }

        .btn-secondary:hover {
            background-color: #ebd169;
        }

        .btn-preview {
            background-color: var(--success-green);
            color: var(--text-white);
        }

        .btn-preview:hover {
            background-color: #238377;
        }

        .btn-danger {
            background-color: var(--danger-red);
            color: white;
            padding: 4px 8px;
            font-size: 0.8rem;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 0.85rem;
        }

        /* Translation Results Output */
        .output-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }

        .output-card {
            background: var(--marine-card);
            border-radius: 6px;
            padding: 16px;
            border-left: 4px solid var(--marine-accent);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .output-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: var(--gold-accent);
            font-weight: bold;
        }

        .output-text {
            font-size: 1rem;
            line-height: 1.4;
            margin-bottom: 12px;
            color: var(--text-white);
        }

        .output-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .play-select-label {
            font-size: 0.8rem;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        /* Notice Box Styles */
        .notice-box {
            background-color: rgba(230, 57, 70, 0.15);
            border: 2px solid var(--danger-red);
            border-radius: 8px;
            padding: 16px;
            text-align: center;
            margin-top: 10px;
        }

        .notice-text {
            color: var(--danger-red);
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Responsive */
        @media (max-width: 850px) {
            .container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">
            <span class="logo-icon">⚓</span>
            <span>SHIP ANNOUNCEMENT SYSTEM PRO</span>
        </div>
        <div class="ship-status">PA-SYSTEM READY | UTC: <span id="clock">00:00</span></div>
    </header>

    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="section-header">
                <span class="section-title">📁 FOLDERS</span>
                <button class="btn-add" id="addFolderBtn" title="Create new folder">+</button>
            </div>
            
            <ul class="folder-list" id="folderList">
                <!-- Folders inserted dynamically -->
            </ul>

            <div class="section-header" style="margin-top: 15px;">
                <span class="section-title">🔊 SAVED ANNOUNCEMENTS</span>
            </div>

            <div class="saved-announcements" id="savedAnnouncements">
                <!-- Saved announcements inserted here -->
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="card">
                <div class="section-header" style="margin-bottom: 12px;">
                    <span class="section-title">📢 NEW ANNOUNCEMENT</span>
                </div>
                
                <textarea id="sourceText" placeholder="Skriv din besked her... (f.eks., 'Godaften alle passagerer. Vi ankommer til havnen om 15 minutter.')"></textarea>

                <!-- Controls Layout: ElevenLabs Integration & Signal Chime -->
                <div class="controls-grid">
                    <!-- ElevenLabs Integration -->
                    <div class="control-group">
                        <label for="elevenApiKey">🎙️ ELEVENLABS API KEY:</label>
                        <input type="password" id="elevenApiKey" class="form-input" placeholder="Indtast ElevenLabs API Key" onchange="saveElevenApiKey(this.value)">
                        <div class="audio-status">Voice ID: <strong style="color:var(--gold-accent)">ccflMOX8sqdvzn7NBkqd</strong></div>
                    </div>

                    <!-- Chime / Audio signal before speech -->
                    <div class="control-group">
                        <label for="chimeFile">🔔 SIGNAL / CHIME (BEFORE ANNOUNCEMENT):</label>
                        <input type="file" id="chimeFile" accept="audio/*" class="file-input" onchange="handleChimeUpload(event)">
                        <div id="chimeStatus" class="audio-status">No audio file selected (default chime tone used)</div>
                    </div>
                </div>

                <div id="ttsStatus" class="audio-status" style="margin:10px 0 14px;padding:10px 12px;background:rgba(0,168,232,.08);border-radius:6px;">
                    🔊 Status: ElevenLabs stemme tilkoblet via Voice ID ccflMOX8sqdvzn7NBkqd.
                </div>

                <div class="section-title" style="margin-bottom: 12px; font-size: 0.95rem;">SELECT TARGET LANGUAGES FOR TRANSLATION:</div>
                <div class="lang-grid">
                    <label class="lang-checkbox">
                        <input type="checkbox" value="da" data-name="Danish" checked> 🇩🇰 Danish
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="en" data-name="English" checked> 🇬🇧 English
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="de" data-name="German" checked> 🇩🇪 German
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="fr" data-name="French"> 🇫🇷 French
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="it" data-name="Italian"> 🇮🇹 Italian
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="zh" data-name="Chinese"> 🇨🇳 Chinese
                    </label>
                    <label class="lang-checkbox">
                        <input type="checkbox" value="fo" data-name="Faroese"> 🇫🇴 Faroese
                    </label>
                </div>

                <div class="btn-group">
                    <button class="btn btn-preview" onclick="previewOriginalText()">
                        🎧 Preview Pronunciation (Before Translation)
                    </button>
                    <button class="btn btn-primary" onclick="translateAndProcess()">
                        🔄 Translate & Generate Audio
                    </button>
                    <button class="btn btn-secondary" onclick="saveCurrentAnnouncement()">
                        💾 Save Announcement to Active Folder
                    </button>
                </div>
            </div>

            <!-- Translation Output Area -->
            <div id="outputSection" class="card" style="display: none;">
                <div class="section-header" style="margin-bottom: 12px;">
                    <span class="section-title">🌐 TRANSLATIONS & PLAYBACK</span>
                    <button class="btn btn-primary btn-small" onclick="playAllTranslations()">
                        ▶️ Play All Selected Languages (With Chime)
                    </button>
                </div>
                
                <div class="output-grid" id="outputGrid">
                    <!-- Translation cards generated here -->
                </div>
            </div>

            <!-- Bottom Warning Notice Box -->
            <div class="notice-box">
                <div class="notice-text">
                    ⚠️ NO ANNOUNCEMENTS AFTER DEPARTURE UNTIL THE CAPTAIN HAS MADE HIS SPEECH ⚠️
                </div>
            </div>
        </main>
    </div>

    <script>
        // ==========================================
        // SÆT DIN FIREBASE CONFIG IND HERUNDER:
        // ==========================================
        const firebaseConfig = {
            // SLET DETTE OG INDSÆT DIN KODE FRA TRIN 2 HER
            apiKey: "DIN_API_KEY",
            authDomain: "dit-projekt.firebaseapp.com",
            databaseURL: "https://dit-projekt-default-rtdb.europe-west1.firebasedatabase.app",
            projectId: "dit-projekt",
            storageBucket: "dit-projekt.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abc123def"
        };

        // Initialiser Firebase
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();
        const dbRef = database.ref('ship_pa_system'); // Her gemmes alt i databasen

        // Global Constants & Variables
        const ELEVENLABS_VOICE_ID = "ccflMOX8sqdvzn7NBkqd";
        
        // Disse starter tomme og bliver fyldt op fra Firebase
        let folders = ["Safety", "Public", "All Pax Area", "Shop"];
        let savedAnnouncements = [];
        let activeFolder = "Safety";
        let currentTranslations = {};
        let uploadedChimeAudio = null;

        // Lyt efter ændringer i Firebase LIVE (Sync over flere PC'er)
        dbRef.on('value', (snapshot) => {
            const data = snapshot.val();
            if (data) {
                if (data.folders) folders = data.folders;
                if (data.announcements) savedAnnouncements = data.announcements;
                
                // Opdater skærmen når vi har modtaget ny data
                loadFolders();
                renderSavedAnnouncements();
            } else {
                // Hvis databasen er helt tom (første gang), gem standard mapperne
                saveDataToFirebase();
            }
        });

        // Funktion til at skubbe data op til Firebase
        function saveDataToFirebase() {
            dbRef.set({
                folders: folders,
                announcements: savedAnnouncements
            });
        }

        // Clock Update
        function updateClock() {
            const now = new Date();
            const time = now.toISOString().substr(11, 5);
            document.getElementById('clock').innerText = time;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Initialize UI
        document.addEventListener('DOMContentLoaded', () => {
            // Load saved ElevenLabs API Key if available (Bliver gemt lokalt på PC'en af sikkerhedshensyn)
            const savedApiKey = localStorage.getItem('elevenlabs_api_key');
            if (savedApiKey) {
                document.getElementById('elevenApiKey').value = savedApiKey;
            }

            document.getElementById('addFolderBtn').addEventListener('click', () => {
                const name = prompt("Enter name for new folder:");
                if (name && name.trim() !== "") {
                    const cleanName = name.trim();
                    if (!folders.includes(cleanName)) {
                        folders.push(cleanName);
                        activeFolder = cleanName;
                        saveDataToFirebase(); // Gem i skyen
                    }
                }
            });
        });

        function saveElevenApiKey(key) {
            localStorage.setItem('elevenlabs_api_key', key.trim()); // API Nøgler bør ikke ligge i den offentlige database
        }

        // Handle File Upload for Chime
        function handleChimeUpload(event) {
            const file = event.target.files[0];
            const statusDiv = document.getElementById('chimeStatus');
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    uploadedChimeAudio = e.target.result;
                    statusDiv.innerText = ` Custom audio loaded: ${file.name}`;
                    statusDiv.style.color = 'var(--success-green)';
                };
                reader.readAsDataURL(file);
            } else {
                uploadedChimeAudio = null;
                statusDiv.innerText = "No audio file selected (default chime tone used)";
                statusDiv.style.color = 'var(--text-dim)';
            }
        }

        // Play Chime (Custom uploaded audio or synthesized Web Audio chime)
        function playChime() {
            return new Promise((resolve) => {
                if (uploadedChimeAudio) {
                    const audio = new Audio(uploadedChimeAudio);
                    audio.onended = resolve;
                    audio.onerror = resolve;
                    audio.play().catch(e => resolve());
                } else {
                    try {
                        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                        const osc1 = audioCtx.createOscillator();
                        const osc2 = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();

                        osc1.type = 'sine';
                        osc2.type = 'sine';
                        
                        osc1.connect(gain);
                        osc2.connect(gain);
                        gain.connect(audioCtx.destination);

                        const now = audioCtx.currentTime;
                        
                        osc1.frequency.setValueAtTime(783.99, now); // G5
                        osc2.frequency.setValueAtTime(659.25, now + 0.35); // E5

                        gain.gain.setValueAtTime(0.3, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.9);

                        osc1.start(now);
                        osc1.stop(now + 0.35);
                        
                        osc2.start(now + 0.35);
                        osc2.stop(now + 0.9);

                        setTimeout(() => {
                            audioCtx.close();
                            resolve();
                        }, 1000);
                    } catch(e) {
                        resolve();
                    }
                }
            });
        }

        // ===================================
        // ELEVENLABS TTS INTEGRATION
        // ===================================
        async function speakElevenLabs(text) {
            const apiKey = document.getElementById('elevenApiKey').value.trim();
            if (!apiKey) {
                alert("Indtast venligst din ElevenLabs API Key i feltet for at afspille stemmen.");
                return false;
            }

            const response = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${ELEVENLABS_VOICE_ID}`, {
                method: 'POST',
                headers: {
                    'Accept': 'audio/mpeg',
                    'Content-Type': 'application/json',
                    'xi-api-key': apiKey
                },
                body: JSON.stringify({
                    text: text,
                    model_id: 'eleven_multilingual_v2',
                    voice_settings: {
                        stability: 0.5,
                        similarity_boost: 0.75
                    }
                })
            });

            if (!response.ok) {
                const errData = await response.json().catch(() => ({}));
                throw new Error(errData.detail?.message || `ElevenLabs Fejl (Status ${response.status})`);
            }

            const blob = await response.blob();
            const audioUrl = URL.createObjectURL(blob);

            return new Promise((resolve) => {
                const audio = new Audio(audioUrl);
                audio.onended = () => {
                    URL.revokeObjectURL(audioUrl);
                    resolve();
                };
                audio.onerror = () => {
                    URL.revokeObjectURL(audioUrl);
                    resolve();
                };
                audio.play().catch(resolve);
            });
        }

        // Browser Fallback if API key is missing or fails
        function speakBrowser(text, lang) {
            return new Promise((resolve) => {
                if (!('speechSynthesis' in window)) return resolve();
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = lang || 'da-DK';
                utterance.onend = resolve;
                utterance.onerror = resolve;
                window.speechSynthesis.speak(utterance);
            });
        }

        // Combined TTS function
        async function speakPromise(text, lang) {
            const apiKey = document.getElementById('elevenApiKey').value.trim();
            if (apiKey) {
                try {
                    await speakElevenLabs(text);
                    return;
                } catch (err) {
                    console.error('ElevenLabs Error:', err);
                    alert(`Fejl fra ElevenLabs: ${err.message}. Bruger browserens standardstemme som fallback.`);
                }
            }
            await speakBrowser(text, lang);
        }

        async function previewOriginalText() {
            const text = document.getElementById('sourceText').value.trim();
            if (!text) {
                alert("Please type some text first.");
                return;
            }
            await playWithChime(text, 'da-DK');
        }

        // Render Folders
        function loadFolders() {
            const list = document.getElementById('folderList');
            list.innerHTML = '';
            
            folders.forEach(folder => {
                const li = document.createElement('li');
                li.className = `folder-item ${folder === activeFolder ? 'active' : ''}`;
                
                const isDefault = ["Safety", "Public", "All Pax Area", "Shop"].includes(folder);
                
                li.innerHTML = `
                    <span onclick="selectFolder('${folder}')">📁 ${folder}</span>
                    ${!isDefault ? `<span class="delete-folder" onclick="deleteFolder(event, '${folder}')">✕</span>` : ''}
                `;
                list.appendChild(li);
            });
        }

        function selectFolder(folderName) {
            activeFolder = folderName;
            loadFolders();
            renderSavedAnnouncements();
        }

        function deleteFolder(e, folderName) {
            e.stopPropagation();
            if (confirm(`Are you sure you want to delete folder "${folderName}" and its saved announcements?`)) {
                folders = folders.filter(f => f !== folderName);
                savedAnnouncements = savedAnnouncements.filter(a => a.folder !== folderName);
                saveDataToFirebase(); // Gem ændringen i skyen
                if (activeFolder === folderName) activeFolder = "Safety";
            }
        }

        // Translation logic using MyMemory API
        async function translateAndProcess() {
            const text = document.getElementById('sourceText').value.trim();
            if (!text) {
                alert("Please type some text first.");
                return;
            }

            const checkboxes = document.querySelectorAll('.lang-grid input[type="checkbox"]:checked');

            const outputGrid = document.getElementById('outputGrid');
            outputGrid.innerHTML = '<p style="color: var(--text-dim)">Fetching translations...</p>';
            document.getElementById('outputSection').style.display = 'block';

            currentTranslations = {};

            // Medtag altid den originale skrevene tekst først
            currentTranslations['original'] = {
                name: "Original Tekst",
                text: text,
                isOriginal: true,
                selectedForPlay: true
            };

            for (let cb of checkboxes) {
                const targetLang = cb.value;
                const langName = cb.getAttribute('data-name');
                
                try {
                    const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=autodetect|${targetLang}`);
                    const data = await res.json();
                    const translatedText = data.responseData.translatedText;

                    currentTranslations[targetLang] = {
                        name: langName,
                        text: translatedText,
                        selectedForPlay: true
                    };
                } catch (err) {
                    currentTranslations[targetLang] = {
                        name: langName,
                        text: "Translation error.",
                        selectedForPlay: false
                    };
                }
            }

            renderOutputCards();
        }

        // Render translation result cards
        function renderOutputCards() {
            const outputGrid = document.getElementById('outputGrid');
            outputGrid.innerHTML = '';

            for (let langCode in currentTranslations) {
                const item = currentTranslations[langCode];
                const ttsLangCode = item.isOriginal ? 'da-DK' : getTTSLangCode(langCode);
                const headerSymbol = item.isOriginal ? '✍️' : getFlag(langCode);

                const card = document.createElement('div');
                card.className = 'output-card';
                card.innerHTML = `
                    <div>
                        <div class="output-header">${headerSymbol} ${item.name}</div>
                        <div class="output-text">${item.text}</div>
                    </div>
                    <div class="output-actions">
                        <label class="play-select-label">
                            <input type="checkbox" id="chk_${langCode}" ${item.selectedForPlay ? 'checked' : ''} onchange="toggleLanguagePlayback('${langCode}', this.checked)">
                            Inkluder i samlet oplæsning
                        </label>
                        <button class="btn btn-primary btn-small" onclick="playWithChime('${escapeQuote(item.text)}', '${ttsLangCode}')">🔔 Læs op</button>
                    </div>
                `;
                outputGrid.appendChild(card);
            }
        }

        function toggleLanguagePlayback(langCode, isChecked) {
            if (currentTranslations[langCode]) {
                currentTranslations[langCode].selectedForPlay = isChecked;
            }
        }

        async function playWithChime(text, lang) {
            await playChime();
            await speakPromise(text, lang);
        }

        async function playAllTranslations() {
            await playChime();
            for (let langCode in currentTranslations) {
                const item = currentTranslations[langCode];
                if (item.selectedForPlay) {
                    const lang = item.isOriginal ? 'da-DK' : getTTSLangCode(langCode);
                    await speakPromise(item.text, lang);
                }
            }
        }

        // Save announcement to active folder
        function saveCurrentAnnouncement() {
            const text = document.getElementById('sourceText').value.trim();
            if (!text) {
                alert("Please type some text before saving.");
                return;
            }

            const title = prompt("Enter a title for this announcement:", text.substring(0, 25) + "...");
            if (!title) return;

            const newItem = {
                id: Date.now(),
                folder: activeFolder,
                title: title,
                text: text
            };

            // Undgå duplicates (sjældent, men for en sikkerheds skyld)
            if(!savedAnnouncements) savedAnnouncements = [];
            
            savedAnnouncements.push(newItem);
            saveDataToFirebase(); // Sender det direkte op i skyen
        }

        function renderSavedAnnouncements() {
            const container = document.getElementById('savedAnnouncements');
            container.innerHTML = '';
            
            if(!savedAnnouncements) return;

            const items = savedAnnouncements.filter(a => a.folder === activeFolder);

            if (items.length === 0) {
                container.innerHTML = `<p style="color: var(--text-dim); font-size:0.85rem;">No saved announcements in this folder.</p>`;
                return;
            }

            items.forEach(item => {
                const div = document.createElement('div');
                div.className = 'saved-card';
                div.innerHTML = `
                    <h4>${item.title}</h4>
                    <p>${item.text}</p>
                    <div class="saved-card-actions">
                        <button class="btn btn-primary btn-small" onclick="loadSavedItem(${item.id})">Load</button>
                        <button class="btn btn-danger" onclick="deleteSavedItem(${item.id})">Delete</button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function loadSavedItem(id) {
            const item = savedAnnouncements.find(a => a.id === id);
            if (item) {
                document.getElementById('sourceText').value = item.text;
                translateAndProcess();
            }
        }

        function deleteSavedItem(id) {
            if (confirm("Are you sure you want to delete this saved announcement?")) {
                savedAnnouncements = savedAnnouncements.filter(a => a.id !== id);
                saveDataToFirebase(); // Sletter det fra skyen
            }
        }

        // Helper functions
        function getTTSLangCode(code) {
            const map = {
                'da': 'da-DK',
                'en': 'en-US',
                'de': 'de-DE',
                'fr': 'fr-FR',
                'it': 'it-IT',
                'zh': 'zh-CN',
                'fo': 'fo-FO'
            };
            return map[code] || 'en-US';
        }

        function getFlag(code) {
            const map = {
                'da': '🇩🇰',
                'en': '🇬🇧',
                'de': '🇩🇪',
                'fr': '🇫🇷',
                'it': '🇮🇹',
                'zh': '🇨🇳',
                'fo': '🇫🇴'
            };
            return map[code] || '';
        }

        function escapeQuote(str) {
            return str.replace(/'/g, "\\'").replace(/\n/g, ' ');
        }
    </script>
</body>
</html>
